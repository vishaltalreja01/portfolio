---
import type { MainSection } from '@/types/sections/main-section.types';
import LinkButton from './link-button.astro';
import Typography from './typography.astro';

export interface Props {
  profile: MainSection;
}

const { profile } = Astro.props;
---

<footer class="mt-16 w-full pb-12 sm:mt-24">
  <!-- Gradient Divider -->
  <div class="mb-12 h-px w-full bg-gradient-to-r from-transparent via-gray-200 to-transparent dark:via-gray-800"></div>

  <div class="flex flex-col items-center gap-10">
    <!-- Social Links -->
    {
      profile.links.length > 0 && (
        <div class="flex flex-col items-center gap-4">
          <Typography
            variant="item-subtitle-secondary"
            class="text-xs font-semibold uppercase tracking-widest opacity-50"
          >
            Connect
          </Typography>
          <div class="flex flex-wrap justify-center gap-4 rounded-full border border-gray-100 bg-gray-50/50 px-8 py-4 shadow-sm backdrop-blur-sm transition-transform duration-300 hover:scale-105 dark:border-gray-700/50 dark:bg-gray-800/30">
            {profile.links.map((link) => (
              <div class="transform transition-transform duration-200 hover:-translate-y-1">
                <LinkButton {...link} />
              </div>
            ))}
          </div>
        </div>
      )
    }

    <!-- Copyright & Credits -->
    <div class="flex flex-col items-center gap-4 text-center">
      <Typography variant="item-subtitle-secondary" class="text-sm font-medium tracking-wide opacity-90">
        &copy; {new Date().getFullYear()} &nbsp; {profile.fullName} &nbsp; All rights reserved.
      </Typography>

      <div class="flex items-center gap-2 text-xs font-medium text-gray-400 dark:text-gray-500">
        <span>Designed & Built with</span>
        <span class="text-red-400 animate-pulse">♥</span>
        <span>using</span>
        <span class="font-semibold text-primary-600 dark:text-primary-400">Astro</span>
        <span>&</span>
        <span class="text-cyan-500 font-semibold">Tailwind</span>
      </div>
    </div>
  </div>
</footer>
