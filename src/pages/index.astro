---
import Layout from '@/web/components/layout.astro';
import Photo from '@/components/photo.astro';
import Description from '@/components/description.astro';
import cv from '@/data';
import '@/web/portfolio.css';
const { config, sections } = cv();
const { main, portfolio, experience, education, testimonials } = sections;
const date = (value: Date) => value.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
const range = (dates: readonly (Date | null)[]) => `${date(dates[0]!)} — ${dates[1] ? date(dates[1]) : 'Present'}`;
const technologies = [
  {
    number: '01',
    title: 'Interfaces that feel right.',
    description: 'Accessible, responsive experiences with attention to the details that matter.',
    tags: ['React', 'Next.js', 'TypeScript', 'Tailwind CSS', 'Astro'],
  },
  {
    number: '02',
    title: 'Built beyond the surface.',
    description: 'Reliable applications, thoughtful APIs, and data that works for your business.',
    tags: ['NestJS', 'PHP', 'Oracle APEX', 'SQL', 'PostgreSQL'],
  },
  {
    number: '03',
    title: 'Ready for the real world.',
    description: 'From collaborating with a team to shipping and maintaining production software.',
    tags: ['Docker', 'Kubernetes', 'Git', 'Agile', 'Team leadership'],
  },
];
---

<Layout {...config} sections={sections}>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header shell">
    <a class="wordmark" href="#profile" aria-label="Vishal Kumar home">vk<span>.</span></a>
    <nav aria-label="Main navigation">
      <a href="#projects">Work</a><a href="#experience">Experience</a><a href="#about">About</a>
    </nav>
    <div class="header-actions">
      <button id="theme-toggle" class="theme-button" aria-label="Switch to dark theme" aria-pressed="false"
        ><svg
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z"></path></svg
        ></button
      >
      <a class="header-contact" href="#contact">Let’s talk <span aria-hidden="true">↗</span></a>
    </div>
  </header>
  <main id="main-content" class="shell">
    <section id="profile" class="hero">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span> OPEN TO WORK & FREELANCE</p>
        <h1>Thoughtful code.<br />Meaningful<br /><span class="serif">experiences.</span></h1>
        <p class="hero-intro">
          Hi, I’m <strong>{main.fullName}.</strong> A full stack developer turning complex ideas into intuitive digital products.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="#projects">Explore my work <span aria-hidden="true">↗</span></a><a
            class="text-link"
            href={main.action?.url}
            download={main.action?.downloadedFileName}>Download CV <span aria-hidden="true">↓</span></a
          >
        </div>
        <div class="hero-location">
          <span aria-hidden="true">◎</span> Based in Naples, Italy <span class="small-divider"></span> Building for everywhere
        </div>
      </div>
      <div class="hero-visual">
        <div class="portrait-frame">
          <Photo src={main.image!} alt="Vishal Kumar" loading="eager" width={600} height={720} /><span
            class="portrait-label">THE PERSON BEHIND THE CODE</span
          >
        </div>
        <div class="current-role">
          <span class="role-icon" aria-hidden="true">&lt;/&gt;</span><div>
            <span class="eyebrow">CURRENTLY BUILDING AT</span><strong>Volantinopiù Srl</strong><span
              >Lead Full Stack Developer</span
            >
          </div><span class="status-dot"></span>
        </div>
        <span class="photo-note">A little curiosity. A lot of craft.</span>
      </div>
    </section>
    <div class="stack-strip">
      <span>MY EVERYDAY TOOLKIT</span><div>
        React <i>✦</i> Next.js <i>✦</i> TypeScript <i>✦</i> NestJS <i>✦</i> PostgreSQL
      </div>
    </div>
    <section id="projects" class="section">
      <div class="section-heading">
        <div><p class="eyebrow">01 / SELECTED WORK</p><h2>Ideas brought <span class="serif">to life.</span></h2></div><p
        >
          A selection of websites and applications<br class="desktop-break" /> I’ve helped shape, build, and ship.
        </p>
      </div>
      <div class="project-grid">
        {
          portfolio.projects.map((project, index) => (
            <article class="project-card">
              <a
                class={`project-image project-image-${index}`}
                href={project.links?.[0]?.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Visit ${project.name} (opens in a new tab)`}
              >
                <>
                  <Photo src={project.image!} alt={`${project.name} website preview`} width={880} height={550} />
                  <span class="project-open" aria-hidden="true">
                    ↗
                  </span>
                </>
              </a>
              <div class="project-meta">
                <>
                  <span>{index === 0 || index === 3 ? 'FULL STACK DEVELOPMENT' : 'FRONTEND DEVELOPMENT'}</span>
                  <span>{project.dates?.[0].getFullYear()}</span>
                </>
              </div>
              <>
                <h3>
                  <a href={project.links?.[0]?.url} target="_blank" rel="noopener noreferrer">
                    {project.name}
                  </a>
                </h3>
                <p>{project.description}</p>
              </>
              <div class="tags">
                {project.tagsList?.tags.map((tag) => (
                  <span>{tag.name}</span>
                ))}
              </div>
              {project.links && project.links.length > 1 && (
                <a class="source-link" href={project.links[1]?.url} target="_blank" rel="noopener noreferrer">
                  View source code ↗
                </a>
              )}
            </article>
          ))
        }
      </div>
    </section>
    <section id="skills" class="section expertise-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 / WHAT I BRING</p><h2>From first idea to <span class="serif">final detail.</span></h2>
        </div>
      </div><div class="expertise-grid">
        {
          technologies.map((item) => (
            <article class="expertise-card">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <>
                <span class="card-number">{item.number} /</span>
                <div class="tags">
                  {item.tags.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
              </>
            </article>
          ))
        }
      </div>
    </section>
    <section id="experience" class="section experience-section">
      <div class="experience-intro">
        <p class="eyebrow">03 / THE JOURNEY</p><h2>
          Always building.<br /><span class="serif">Always learning.</span>
        </h2><p>From freelance projects to leading a development team, every role brings a new perspective.</p><a
          class="text-link"
          href="/cv.pdf"
          download="CV-Vishal_Kumar.pdf">Get the full CV <span aria-hidden="true">↓</span></a
        >
      </div><div class="timeline">
        {
          experience.jobs.map((job, index) => (
            <article class="job">
              <h3>{job.role}</h3>
              <p class="company">
                {job.company} <span>· {job.location}</span>
              </p>
              <Description content={job.description} classList={['job-description']} />
              <>
                <div class="job-top">
                  <span>{range(job.dates)}</span>
                  {index === 0 && <span class="current-badge">CURRENT</span>}
                </div>
                <div class="tags">
                  {job.tagsList?.tags.map((tag) => (
                    <span>{tag.name}</span>
                  ))}
                </div>
              </>
            </article>
          ))
        }
      </div>
    </section>
    <section id="about" class="section about-section">
      <div>
        <p class="eyebrow">04 / A LITTLE ABOUT ME</p><h2>
          A developer’s mindset.<br /><span class="serif">A human perspective.</span>
        </h2><p>
          I enjoy making complicated things feel simple. My work brings together thoughtful interfaces, reliable
          systems, and a curiosity about how people use technology.
        </p><p>
          Based in Naples, I’m also pursuing a master’s in Data Science at the University of Naples Federico II,
          bringing a growing understanding of data to the products I build.
        </p><div class="languages"><span>English · C1</span><span>Urdu · Native</span><span>Sindhi · Native</span></div>
      </div><div id="education" class="education-list">
        {
          education.diplomas.map((diploma) => (
            <article>
              <h3>{diploma.title}</h3>
              <p>{diploma.institution}</p>
              <>
                <span class="eyebrow">{range(diploma.dates)}</span>
                <p class="education-description">{diploma.description}</p>
              </>
            </article>
          ))
        }
      </div>
    </section>
    <section id="testimonials" class="section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">05 / KIND WORDS</p><h2>Good work starts with <span class="serif">good people.</span></h2>
        </div>
      </div><div class="testimonial-grid">
        {
          testimonials.testimonials.map((testimonial) => (
            <figure class="testimonial">
              <blockquote>{testimonial.content}</blockquote>
              <>
                <span class="quote-mark" aria-hidden="true">
                  “
                </span>
                <figcaption>
                  <>
                    <Photo src={testimonial.image!} alt="" width={48} height={48} />
                    <div>
                      <>
                        <strong>{testimonial.author}</strong>
                        <span>{testimonial.relation}</span>
                      </>
                    </div>
                  </>
                </figcaption>
              </>
            </figure>
          ))
        }
      </div>
    </section>
    <section id="contact" class="contact-section">
      <div>
        <p class="eyebrow"><span class="status-dot"></span> HAVE SOMETHING IN MIND?</p><h2>
          Let’s make<br /><span class="serif">something matter.</span>
        </h2><p>A new product, a fresh perspective, or just a hello.<br />I’d love to hear from you.</p>
      </div><div class="contact-actions">
        <a class="button primary" href="mailto:vishaltalreja01@gmail.com"
          >Start a conversation <span aria-hidden="true">↗</span></a
        ><a class="email-link" href="mailto:vishaltalreja01@gmail.com">vishaltalreja01@gmail.com</a><a
          class="text-link"
          href="tel:+393532124142">+39 353 212 4142</a
        >
      </div>
    </section>
  </main>
  <footer class="site-footer shell">
    <a class="wordmark" href="#profile" aria-label="Back to top">vk<span>.</span></a><p>
      © {new Date().getFullYear()} Vishal Kumar. Made with care.
    </p><div>
      <a href="https://github.com/vishaltalreja01" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a
        href="https://linkedin.com/in/vishaltalreja01"
        target="_blank"
        rel="noopener noreferrer">LinkedIn ↗</a
      ><a href="#profile">Back to top ↑</a>
    </div>
  </footer>
</Layout>
<script>
  const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
  const syncTheme = () => {
    const dark = document.documentElement.classList.contains('dark');
    button?.setAttribute('aria-pressed', String(dark));
    button?.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} theme`);
  };
  syncTheme();
  button?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
    syncTheme();
  });
  const links = document.querySelectorAll<HTMLAnchorElement>('nav a');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting)
          links.forEach((link) => {
            if (link.hash === `#${entry.target.id}`) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
      });
    },
    { rootMargin: '-15% 0px -65% 0px' }
  );
  document.querySelectorAll('main section[id]').forEach((section) => observer.observe(section));
</script>
